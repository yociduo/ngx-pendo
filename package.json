{
  "name": "ngx-pendo-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:example": "ng serve example-app",
    "start:standalone": "ng serve standalone-app",
    "build": "ng build",
    "build:lib": "ng build ngx-pendo && pnpm run cp:readme",
    "build:schematics": "tsc -p projects/ngx-pendo/tsconfig.schematics.json && pnpm run cp:schematics",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:schematics": "vitest run --config projects/ngx-pendo/vitest.schematics.config.ts",
    "lint": "ng lint",
    "cp": "pnpm run cp:readme && pnpm run cp:schematics",
    "cp:readme": "copyfiles ./README.md ./dist/ngx-pendo",
    "cp:schematics": "cd projects/ngx-pendo && copyfiles schematics/*/schema.json schematics/*/files/** schematics/collection.json ../../dist/ngx-pendo/",
    "release": "release-it",
    "publish": "cd dist/ngx-pendo && pnpm publish --no-git-checks",
    "prepare": "husky"
  },
  "author": "Eden Wang",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/animations": "~22.1.8",
    "@angular/common": "~22.1.8",
    "@angular/compiler": "~22.1.8",
    "@angular/core": "~22.1.8",
    "@angular/forms": "~22.1.8",
    "@angular/platform-browser": "~22.1.8",
    "@angular/platform-browser-dynamic": "~22.1.8",
    "@angular/router": "~22.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.8",
    "@angular-devkit/schematics": "~22.1.8",
    "@angular/build": "~22.1.8",
    "@angular/cli": "~22.1.8",
    "@angular/compiler-cli": "~22.1.8",
    "@angular/language-service": "~22.1.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@release-it/bumper": "^7.0.6",
    "@release-it/conventional-changelog": "^11.0.1",
    "@schematics/angular": "~22.1.8",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.0.0",
    "copyfiles": "^2.3.0",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.2.7",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.2.5",
    "release-it": "^20.2.0",
    "stylelint": "^16.0.0",
    "stylelint-config-recommended": "^14.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix -c eslint.config.js"
    ],
    "projects/ngx-pendo/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix -c projects/ngx-pendo/eslint.config.js"
    ],
    "projects/example-app/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix -c projects/example-app/eslint.config.js"
    ],
    "projects/standalone-app/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix -c projects/standalone-app/eslint.config.js"
    ],
    "src|projects/**/*.{scss,less,css}": [
      "stylelint --fix"
    ],
    "src|projects/**/*.{ts,js,json,md,scss,less,css}": [
      "prettier --write --config .prettierrc"
    ]
  }
}
